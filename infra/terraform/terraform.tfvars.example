region                       = "eu-central-1"
environment                  = "staging"
certificate_arn              = "arn:aws:acm:eu-central-1:123456789012:certificate/REPLACE-ME"
github_repository            = "dkkdark/SupportOps-AI"
create_github_oidc_provider   = false
desired_count                = 0
# Choose an available PostgreSQL 17 minor in your region before applying.
db_engine_version            = "17.6"
# image_digest = "sha256:..."
# llm_secret_arn = "arn:aws:secretsmanager:..."
llm_model = "gpt-5.4-mini"
embedding_model = "text-embedding-3-large"
public_base_url = "https://REPLACE-WITH-YOUR-DOMAIN.example"
# alarm_email = "you@example.com"

# Configure Stripe/SMTP/Turnstile secret ARNs and reviewed policy URLs before paid launch.
# Never put raw secrets in tfvars or Terraform state.
