APP_ENV=development
DEMO_RELEASE=true
DEMO_AI_BUDGET_USD=5
PUBLIC_BASE_URL=http://127.0.0.1:8010
DATABASE_URL=sqlite:///./var/supportops.db
# Real models for ordinary business workspaces. Sample workspaces remain synthetic.
MODEL_PROVIDER=openai
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AGENT_MODEL=gpt-5.4-mini
VERIFIER_MODEL=gpt-5.4-mini
EMBEDDING_MODEL=text-embedding-3-large
# Semantic vectors use Qdrant. SQL remains the system of record for business data.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=supportops
QDRANT_TIMEOUT_SECONDS=10
AGENT_MAX_TURNS=6
AGENT_MAX_TOOLS=8
AGENT_TIMEOUT_SECONDS=120
AGENT_MAX_OUTPUT_TOKENS=3000
AGENT_PROVIDER_COST_LIMIT=0.40
AGENT_RUN_CREDIT_RESERVE=90
# Update rates when changing models/provider pricing. USD per million tokens.
MODEL_INPUT_USD_PER_MILLION=0.75
MODEL_OUTPUT_USD_PER_MILLION=4.50
VERIFIER_INPUT_USD_PER_MILLION=0.75
VERIFIER_OUTPUT_USD_PER_MILLION=4.50
EMBEDDING_INPUT_USD_PER_MILLION=0.13
# Offline fixtures only: set both providers to baseline explicitly.
# MODEL_PROVIDER=baseline
# EMBEDDING_PROVIDER=baseline
SESSION_DAYS=7
ALLOW_DEMO_SIGNUP=false
REQUIRE_VERIFIED_EMAIL=true
PUBLIC_INTAKE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Gmail sender/contact. Put a Google App Password in SMTP_PASSWORD locally only.
SUPPORT_EMAIL=info.xenonimus@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info.xenonimus@gmail.com
SMTP_PASSWORD=
SMTP_FROM=SupportOps AI <info.xenonimus@gmail.com>
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=10
# Future paid release only. Checkout is disabled while DEMO_RELEASE=true.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_GROWTH_PRICE_ID=
STRIPE_SCALE_PRICE_ID=
STRIPE_AUTOMATIC_TAX=false
LEGAL_BUSINESS_NAME=
LEGAL_CONTACT_EMAIL=info.xenonimus@gmail.com
LEGAL_TERMS_URL=
LEGAL_PRIVACY_URL=
LEGAL_DOCUMENTS_APPROVED=false
# Synthetic retail demo only.
ORDERS_API_URL=http://127.0.0.1:8001
ORDERS_TIMEOUT_SECONDS=2
FAULT_INJECTION_ENABLED=false
OTEL_SERVICE_NAME=supportops-api
OTEL_EXPORTER_OTLP_ENDPOINT=
CODE_VERSION=local
