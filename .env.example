APP_ENV=development
DATABASE_URL=sqlite:///./var/supportops.db
ORDERS_API_URL=http://127.0.0.1:8001
ORDERS_TIMEOUT_SECONDS=2
MODEL_PROVIDER=baseline
# Optional live provider: MODEL_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
# Browser sessions expire after this many days. Production cookies require HTTPS.
SESSION_DAYS=7
# Isolated sample-workspace signup is disabled in production by default.
ALLOW_DEMO_SIGNUP=false
FAULT_INJECTION_ENABLED=false
OTEL_SERVICE_NAME=supportops-api
OTEL_EXPORTER_OTLP_ENDPOINT=
CODE_VERSION=local
MODEL_INPUT_USD_PER_MILLION=0
MODEL_OUTPUT_USD_PER_MILLION=0
